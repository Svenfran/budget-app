{
  "name": "budget-app-ionic-frotend-new",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "build:dev": "cross-env APP_ENV=dev ionic build --configuration development",
    "build:prod": "cross-env APP_ENV=prod ionic build --configuration production",
    "check-device": "powershell -Command \"if ((adb devices | Select-String '\\s*device$')) { Write-Host '✅ Gerät gefunden' } else { Write-Error '❌ Gerät nicht erkannt!'; exit 1 }\"",
    "android:dev": "npm run check-device && cross-env APP_ENV=dev ionic cap sync android --configuration development && cd android && gradlew.bat clean assembleDevDebug installDevDebug",
    "android:prod": "npm run check-device && cross-env APP_ENV=prod ionic cap sync android --configuration production && cd android && gradlew.bat clean assembleProdRelease installProdRelease",
    "android:prod:apk": "cross-env APP_ENV=prod ionic cap sync android --configuration production && cd android && gradlew.bat clean assembleProdRelease"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.0.0",
    "@angular/cdk": "^19.1.3",
    "@angular/common": "^19.0.0",
    "@angular/compiler": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/forms": "^19.0.0",
    "@angular/platform-browser": "^19.0.0",
    "@angular/platform-browser-dynamic": "^19.0.0",
    "@angular/router": "^19.0.0",
    "@capacitor-community/file-opener": "7.0.0",
    "@capacitor/android": "7.4.3",
    "@capacitor/app": "7.0.0",
    "@capacitor/core": "7.4.3",
    "@capacitor/device": "^7.0.0",
    "@capacitor/filesystem": "7.0.0",
    "@capacitor/haptics": "7.0.0",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/status-bar": "7.0.0",
    "@hugotomazi/capacitor-navigation-bar": "4.0.1",
    "@ionic/angular": "^8.7.4",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@stomp/stompjs": "^7.0.0",
    "@types/moment": "^2.11.29",
    "cross-env": "^10.0.0",
    "date-fns": "^4.1.0",
    "ionicons": "^7.0.0",
    "moment": "^2.30.1",
    "net": "1.0.2",
    "quill": "2.0.3",
    "rxjs": "~7.8.0",
    "sockjs-client": "^1.6.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.1901.4",
    "@angular-devkit/build-angular": "^19.2.17",
    "@angular-devkit/core": "19.1.4",
    "@angular-devkit/schematics": "19.1.4",
    "@angular-eslint/builder": "^19.0.0",
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/schematics": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@angular/cli": "19.1.4",
    "@angular/compiler-cli": "^19.0.0",
    "@angular/language-service": "^19.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "7.4.3",
    "@ionic/angular-toolkit": "^12.3.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.10.10",
    "@types/sockjs-client": "^1.5.4",
    "@types/stompjs": "2.3.9",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.6.3"
  },
  "description": "An Ionic project"
}
